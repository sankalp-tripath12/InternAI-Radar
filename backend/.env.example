# --- App ---
APP_NAME=InternAI Radar
APP_ENV=development
DEBUG=true

# --- Database ---
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql+asyncpg://internai:internai_dev_password@localhost:5432/internai_radar

# --- Redis (Tier 2 — placeholder for now, not used until we actually need it) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=replace_this_with_a_real_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000

# --- AI (Tier 2 — not used yet) ---
OPENAI_API_KEY=

# --- Email (Tier 1 notification channel — filled in when we reach Phase 5) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
